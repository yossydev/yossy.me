{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yossy-me",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-09",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "yossy.me/*",
      "zone_id": "42a98865bbe38de65a128823a0f155b9"
    }
  ]
}
